# FinTrack Environment Configuration Example

# Backend Settings
PROJECT_NAME="FinTrack"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-for-development-only-change-in-production"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="fintrack"
POSTGRES_PASSWORD="fintrack_password"
POSTGRES_DB="fintrack_db"
DATABASE_URL="postgresql+asyncpg://fintrack:fintrack_password@localhost:5432/fintrack_db"

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
